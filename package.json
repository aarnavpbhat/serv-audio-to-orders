{
  "name": "serv-audio-orders",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=22" },
  "scripts": {
    "pipeline": "pnpm --silent --filter @serv/pipeline cli",
    "eval": "pnpm --silent --filter @serv/pipeline cli eval",
    "feed": "pnpm --silent --filter @serv/pipeline cli feed",
    "fixtures:build": "pnpm --silent --filter @serv/pipeline fixtures:build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @serv/web dev",
    "build": "pnpm --filter @serv/web build",
    "test:e2e": "pnpm --filter @serv/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript-eslint": "^8.71.0"
  }
}
