# Deepgram (Nova-3 transcription). Free credit at console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_key_here
# Google Gemini (extraction + tie-breakers). Free tier at aistudio.google.com
GEMINI_API_KEY=your_gemini_key_here
# Optional: pin a Gemini model id (default: gemini-flash-latest alias)
GEMINI_MODEL=

# Webhook target. Defaults to the Next.js mock receiver.
WEBHOOK_URL=http://localhost:3000/api/mock-webhook
# Standard Webhooks secret (whsec_<base64>). Generate one with: pnpm pipeline secret
WEBHOOK_SECRET=whsec_REPLACE_ME

# Site placeholders until Serv shares real values
LOCATION_ID=store_demo_001
LANE_ID=lane_1

# Stereo channel roles, e.g. 0=customer,1=crew. Unset means diarization.
CHANNEL_MAP=
# Recording wall-clock start (ISO 8601). Unset means filename pattern, then file mtime.
AUDIO_START_UTC=
# Transcription language. multi = Nova-3 English/Spanish code-switching (flags non-English orders)
STT_LANGUAGE=multi
